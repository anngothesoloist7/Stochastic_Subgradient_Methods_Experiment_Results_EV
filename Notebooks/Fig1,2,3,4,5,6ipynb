s_data_SPDS_constraint.pkl\n"]}]},{"cell_type":"markdown","metadata":{"id":"syBRqxd7rSZ2"},"source":["# Task 6"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"EY9Th1dNFW4s"},"outputs":[],"source":["import pickle\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import os\n","# from pandas.core.indexes.api import union_indexes"]},{"cell_type":"markdown","metadata":{"id":"kjYV-skZYjQG"},"source":["![image.png](data:image/png;base64,)"]},{"cell_type":"markdown","metadata":{"id":"4cj_YbAF7bMJ"},"source":["## Setup functions"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"GDFLXqtwaPkL"},"outputs":[],"source":["# --- ENVY FREENESS METRICS ---\n","def calculate_ces_utility(allocation_vec, valuations_vec, m=1):\n","    \"\"\"\n","    Calculates CES utility for a single user based on the formula:\n","    U_i(x_i) = (sum_j (v_ij * x_ij)^m)^(1/m)\n","\n","    Parameters:\n","    - allocation_vec: (k,) array of allocated goods for one user\n","    - valuations_vec: (k,) array of valuation weights for one user\n","    - m: exponent parameter. Can be an integer/float or 'inf'.\n","      If m='inf', calculates U_i(x_i) = max_j (v_ij * x_ij)\n","\n","    Returns:\n","    - Scalar utility value for the user.\n","    \"\"\"\n","    # Element-wise product: value derived from each item\n","    # shape: (k,)\n","    product = valuations_vec * allocation_vec\n","\n","    if m == 'inf':\n","        # Limit case: Max over items\n","        return np.max(product, axis=1)\n","    else:\n","        # Standard CES form\n","        # We handle potential negative values by taking abs, though in this context x and v are usually non-negative.\n","        sum_pow = np.sum(np.power(product, m), axis=1)\n","        return np.power(sum_pow, 1/m)\n","\n","def envy_freeness_ces(allocation, valuations, m=1):\n","    \"\"\"\n","    Checks Loose Envy Freeness condition using CES utility.\n","    User i envies User j if U_i(A_j) > U_i(A_i) + epsilon.\n","\n","    Parameters:\n","    - allocation: (n, k) matrix of allocated goods\n","    - valuations: (n, k) matrix of linear valuations weights\n","    - m: exponent parameter for CES utility. Can be an integer/float or 'inf'.\n","    - epsilon: tolerance for envy check. U_i(A_j) > U_i(A_i) + epsilon.\n","    - return_relative_envy: If True, max_user_envy will be (Max_j U_i(A_j) - U_i(A_i)) / U_i(A_i).\n","                            Otherwise, it returns the absolute difference.\n","\n","    Returns:\n","    - satisfaction_pct: Percentage of users who do not envy anyone (max_envy <= epsilon)\n","    - max_user_envy: List of max envy values for each user.\n","                     If return_relative_envy is True, Value = (Max_j U_i(A_j) - U_i(A_i)) / U_i(A_i)\n","                     Else, Value = (Max_j U_i(A_j) - U_i(A_i))\n","    \"\"\"\n","    n = len(allocation)\n","\n","    # Calculate utilities of each user for their own bundle\n","    u_own = calculate_ces_utility(allocation, valuations, m)\n","    user_envy_data = []\n","\n","    for i in range(n):\n","        # Calculate utility of user i for EVERYONE's bundle\n","        # We tile user i's valuation to match the shape of allocation matrix\n","        val_i_matrix = np.tile(valuations[i], (n, 1))\n","        u_i_all = calculate_ces_utility(allocation, val_i_matrix, m)\n","\n","        # Calculate difference: U_i(A_j) - U_i(A_i) (shape (10, 1) - scalar)\n","        envy_values = u_i_all - u_own[i]\n","        user_envy_data.append(envy_values)\n","\n","    # Create Dataframe\n","    df = pd.DataFrame(user_envy_data, index=np.arange(1, n+1, 1), columns=np.arange(1, n+1, 1))\n","    df.index.name = 'User_I (Evaluatee)'\n","    df.columns.name = 'User_J (Evaluator)'\n","\n","    return df\n","\n","# --- PROPORTIONAL FAIRNESS ---\n","def proportional_fairness_ces(allocation, valuations, budgets, m=1, epsilon=0, total_resources=None, return_relative_envy=False):\n","    \"\"\"\n","    Checks Proportional Fairness using CES utility.\n","    Condition: U_i(A_i) >= (B_i / Total_Budget) * U_i(Total_Resources)\n","    \"\"\"\n","    n = allocation.shape[0]\n","    budgets = np.array(budgets, dtype=float)\n","    total_budget = np.sum(budgets)\n","\n","    # If total resources not provided, sum the current allocation\n","    if total_resources is None:\n","        total_resources = np.sum(allocation, axis=0)\n","\n","    # Calculate U_i(A_i) (Own utility)\n","    u_own = calculate_ces_utility(allocation, valuations, m)\n","    print(allocation.shape)\n","    print(valuations.shape)\n","    print(u_own.reshape(-1, 1).shape)\n","\n","    fair_utilities = []\n","\n","    for i in range(n):\n","        # Calculate U_i(Total_Resources) for each user\n","        total_bundle = total_resources.reshape(1, -1)  # Shape: (1, 24)\n","        val_i_reshaped = valuations[i].reshape(1, -1)  # Shape: (1, 24)\n","\n","        u_i_all_goods = calculate_ces_utility(total_bundle, val_i_reshaped, m)[0]\n","\n","        # Proportional share required\n","        required_share = (budgets[i] / total_budget) * u_i_all_goods\n","        fair_utilities.append(required_share)\n","\n","\n","    return u_own, fair_utilities"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"sRw72CyjZcTQ"},"outputs":[],"source":["def create_heatmap(df, ax):\n","  df = df.sort_index(ascending=False)\n","  if df.shape[0] < 20:\n","    obj = sns.heatmap(df, vmin=-1, vmax = 1,\n","              cmap='coolwarm', center=0,\n","              square=True, ax=ax, annot=True, fmt='.2f')\n","  else:\n","    obj = sns.heatmap(df, vmin=-1, vmax = 1,\n","                      center=0, cmap='coolwarm', ax=ax)\n","\n","  ax.set_title(\"Pairwise Envy Heatmap (GD)\")\n","  ax.set_xlabel('User_I (Evaluatee)')\n","  ax.set_ylabel('User_J (Evaluator)')\n","\n","def create_barplot(user_df, fair_df, ax):\n","  n_users = len(user_df)\n","  x_positions = range(1, n_users + 1)\n","\n","  obj = sns.barplot(x=x_positions, y=user_df, color=\"blue\", ax=ax)\n","\n","  # Add threshold lines\n","  for i, bar in enumerate(ax.patches):\n","      threshold = fair_df[i]\n","      ax.hlines(threshold,\n","                xmin=bar.get_x(),\n","                xmax=bar.get_x() + bar.get_width(),\n","                colors='red',\n","                linewidth=1)\n","\n","  tick_positions = []\n","  tick_labels = []\n","\n","  for i in range(n_users):\n","      user_id = i + 1  # Since we start from user 1\n","      if user_id % 5 == 0:  # Show labels for user 5, 10, 15, etc.\n","          tick_positions.append(i)  # Position in the barplot (0-indexed)\n","          tick_labels.append(str(user_id))\n","\n","  ax.set_xticks(tick_positions)\n","  ax.set_xticklabels(tick_labels)\n","\n","  ax.set_title(f\"Proportionality Verification ({n_users} users) (GD)\")\n","  ax.set_xlabel(\"User ID\")\n","  ax.set_ylabel(\"User Utility\")\n","\n","def metrics_graph(sgd_envy_df, sgd_data_pro, figsize=(12, 8)):\n","  \"\"\" Draw bar chart to compare utility of users with their proportional threshold \"\"\"\n","  # sgd_data_pro[0] is u_own, sgd_data_pro[1] is fair_utilities\n","  sgd_user_utility = np.array(sgd_data_pro[0], dtype=float)\n","  sgd_fair_utility = np.array(sgd_data_pro[1], dtype=float)\n","\n","  # Create 1 row and 2 columns for the subplots\n","  fig, ax = plt.subplots(1, 2, figsize=figsize)\n","  fig.suptitle(f\"Fairness Verification\", fontsize=16) # Overall title\n","\n","  # --- Row 1: SGD Data ---\n","  create_barplot(sgd_user_utility, sgd_fair_utility, ax=ax[0])\n","  create_heatmap(sgd_envy_df, ax=ax[1])\n","\n","  # Adjust layout to make space for the main title\n","  plt.tight_layout()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"OY592se78uHb","colab":{"base_uri":"https://localhost:8080/","height":35},"executionInfo":{"status":"ok","timestamp":1764979671127,"user_tz":-420,"elapsed":9,"user":{"displayName":"Hong Chu","userId":"14501893030136914855"}