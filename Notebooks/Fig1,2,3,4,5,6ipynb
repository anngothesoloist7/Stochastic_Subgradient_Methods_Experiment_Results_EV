cp.sum(X[i]) <= capacity_b[i]) # Corrected constraint\n","\n","  prob = cp.Problem(objective, constraints)\n","\n","  # Choose CLARABEL and set verbose=True.\n","  # CLARABEL is excellent for this because it supports exponential cones and prints clear Primal/Dual objective logs.\n","  print(f\"Starting solver with verbose=True...\")\n","  # If you don't have CLARABEL, you can try cp.SCS or cp.ECOS\n","  try:\n","      prob.solve(solver=cp.CLARABEL, verbose=False)\n","  except cp.error.SolverError:\n","      print(\"CLARABEL failed or not installed. Trying SCS...\")\n","      prob.solve(solver=cp.SCS, verbose=False)\n","\n","  # ----------------------\n","\n","  if prob.status not in ['optimal', 'optimal_inaccurate']:\n","      print(f\"\\nCentralized solver failed/infeasible. Status: {prob.status}\")\n","      return None\n","\n","  return np.maximum(X.value, 0.0)"],"metadata":{"id":"qySnu4VXDVQe"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## SPDS Time"],"metadata":{"id":"meeIyZAAJCoL"}},{"cell_type":"code","source":["import pickle\n","base_dir = \"/content/drive/MyDrive/experiment_result/time_termination\"\n","sizes = [\"10\", \"50\", \"200\", \"300\", \"400\", \"500\"]\n","keys = [\"10u_24i\", \"50u_60i\", \"200u_240i\", \"300u_360i\", \"400u_480i\", \"500u_600i\"]\n","\n","for i in range(len(sizes)):\n","    load_path = f\"{base_dir}/{sizes[i]}users_data_SPDS_constraint.pkl\"\n","    with open(load_path, 'rb') as f:\n","        results = pickle.load(f)\n","    total_time = results['sgd_run']['total_time']\n","    spds_time_tracker[keys[i]] = total_time"],"metadata":{"id":"FDZWYJINJENv"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## 10 users 24 items"],"metadata":{"id":"oNHtHdgpEJSS"}},{"cell_type":"code","source":["FACTOR_DIR = \"/content/drive/MyDrive/EV_charging_project/datasets/valuation_new/val_10u_24i\"\n","try:\n","    U = np.load(os.path.join(FACTOR_DIR, \"user_factors.npy\"))\n","    P = np.load(o