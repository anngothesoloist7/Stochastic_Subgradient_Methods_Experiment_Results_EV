') from keys like '50u_60i'.\"\"\"\n","    return int(re.match(r\"(\\d+)u\", key).group(1))\n","\n","def scalability_graph(solver_times, spds_times):\n","    # --- Extract users & times ---\n","    users = np.array([extract_users(k) for k in solver_times.keys()])\n","    solver_vals = np.array(list(solver_times.values()))\n","\n","    spds_vals = np.array([spds_times[k] for k in solver_times.keys()])\n","    spds_per_user = spds_vals / users   # divide SPDS time by number of users\n","\n","    # --- Sort by number of users for clean curve ---\n","    idx = np.argsort(users)\n","    users = users[idx]\n","    solver_vals = solver_vals[idx]\n","    spds_per_user = spds_per_user[idx]\n","\n","    # --- Plot ---\n","    plt.figure(figsize=(8, 6))\n","    plt.loglog(users, solver_vals, '-s', markersize=8, linewidth=2, label=\"Centralized Solver\")\n","    plt.loglog(users, spds_per_user, '-o', markersize=8, linewidth=2, label=\"Distributed SPDS\")\n","\n","    plt.xlabel(\"Number of Agents (N)\", fontsize=13)\n","    plt.ylabel(\"Time to Converge (s)\", fontsize=13)\n","    plt.title(\"System Scalability\", fontsize=14)\n","    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.5)\n","    plt.legend(fontsize=12)\n","    plt.tight_layout()"],"metadata":{"id":"mf9MOB_zLkCv"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["scalability_graph(solver_time_tracker, spds_time_tracker)\n","plt.savefig(\"/content/drive/MyDrive/EV_charging_project/images/scalbility_graph.png\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":607},"id":"cWNlxnimOfZE","executionInfo":{"status":"ok","timestamp":1764984099410,"user_tz":-420,"elapsed":1217,"user":{"displayName":"Hong Chu","userId":"14501893030136914855"}},"outputId":"60b3bc15-93af-4704-b408-fdaef6435491"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"cDHRNW-PEcfi"},"source":["# Task 5b: Robustness"]},{"cell_type":"markdown","metadata":{"id":"YscDCnB1F5en"},"source":["**Goal:** Demonstrate the algorithm's versatility across different utility functions and its superior scaling compared to centralized solvers."]},{"cell_type":"code","execution_count":null,"metadata":{"id":"CzNmRPTlG3Cj"},"outputs":[],"source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import pickle, time\n","import cvxpy as cp\n","import time, io, os\n","import sys, scs, clarabel"]},{"cell_type":"markdown","metadata":{"id":"B1CdE1zzF0gV"},"source":["![image.png](data:image/png;base64,)"]},{"cell_type":"markdown","metadata":{"id":"PRUZori2M77-"},"source":["Subplot (a): Utility Function Robustness\n","Y-axis: Relative Error (Log Scale).\n","Description: Shows convergence for three different utility types: Linear, Cobb-Douglas, and Leontief. All curves decay, proving the algorithm works even for non-smooth utilities.\n","\n","\n","Subplot (b): System Scalability\n","X-axis: Number of Agents (N) (Log Scale).\n","Y-axis: Time to Converge (s) (Log Scale).\n","Description: Compares the computational scaling.\n","Centralized Solver (Black Squares): Shows a steep, cubic scaling slope ($O(N^3)$).\n","Distributed SPDS (Blue Circles): Shows a much shallower, linear scaling slope ($O(N)$), demonstrating superior scalability."]},{"cell_type":"markdown","metadata":{"id":"9TO0Yqnc-zLQ"},"source":["Stochastic Gradient Descent with per-iteration:\n","\n","    1. Random agent selection: O(1)\n","    2. Solve convex problem for that agent: O(m^3) with CVXPY (ECOS/SCS)\n","    3. Update prices and constraints: O(m)\n","    \n","    Expected complexity: O(T * m^3) where T = iterations\n","\n","SPDS Algorithm Analysis:\n","    \n","    1. Per Iteration:\n","       - Select random agent: O(1)\n","       - Solve buyer_best_response_cvx: O(m^3) (convex solver)\n","       - Update prices: O(m)\n","    \n","    2. Iteration Count:\n","       - SGD typically needs O(1/ε²) iterations for ε-accuracy\n","       - In practice: ~O(n log n) or ~O(√n) iterations\n","    \n","    3. Total: O(T * m³) where T = iteration count"]},{"cell_type":"markdown","metadata":{"id":"vhh7zKpCG3Cr"},"source":["## Setup functions"]},{"cell_type":"code","source":["# --- Hàm xây dựng Ma trận A (từ Ảnh 2) ---\n","def build_A_matrix(n_chargers: int, n_slots: int) -> np.ndarray:\n","    \"\"\"\n","    Xây dựng ma trận ràng buộc A (slot-matrix constraint)\n","    Kích thước: (n_slots, n_chargers * n_slots)\n","    \"\"\"\n","    # 1. Tạo ma trận đơn vị I_T (kích thước T x T)\n","    I_T = np.eye(n_slots)\n","\n","    # 2. Lặp lại (tile) ma trận I_T C lần theo chiều ngang (1, C)\n","    A = np.tile(I_T, (1, n_chargers))\n","\n","    return A"],"metadata":{"id":"QceqUxjkGNqx"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"lFHrZ2RCG3Cr"},"outputs":[],"source":["# --- PROPOSED ALGORITHM  ---\n","def buyer_best_response_cvx(v_i, p, A, q_i, B_i, utility_type=\"Linear\"):\n","    \"\"\"\n","    max    B_i * log(v_i · x)\n","    s.t.   x >= 0\n","           (price + A^T q_i)^T x <= B_i\n","    \"\"\"\n","    m = len(v_i)             # number of goods\n","    eps = 1e-12\n","\n","    x = cp.Variable(m, nonneg=True)\n","\n","    # Utility\n","    if utility_type == \"Linear\":\n","        util = v_i @ x + eps\n","        objective = cp.Maximize(B_i * cp.log(util))\n","\n","    elif utility_type == \"Cobb-Douglas\":\n","        # Normalize weights α_j = v_j / sum(v)\n","        alpha = v_i / (np.sum(v_i) + eps)\n","        # log utility = sum_j α_j log(x_j)\n","        util = cp.sum(cp.multiply(alpha, cp.log(x + eps)))\n","        objective = cp.Maximize(B_i * util)\n","\n","    elif utility_type == \"Leontief\":\n","        # u = min_j x_j / v_j   ->   maximize t  s.t.  x_j >= t * v_j\n","        t = cp.Variable()\n","        constraints = [x >= t * v_i, t >= 0]\n","        objective = cp.Maximize(t)\n","\n","\n","    # EFFECTIVE PRICE IS CORRECTED HERE\n","    # price: (m,)\n","    # A.T @ q_i: (m,)\n","    effective_price = p + A.T @ q_i\n","\n","    # Budget constraint\n","    constraint = [effective_price @ x <= B_i]\n","\n","    prob = cp.Problem(objective, constraint)\n","    try:\n","        prob.solve(solver=\"ECOS\", warm_start=True)\n","    except:\n","        prob.solve(solver=\"SCS\")\n","\n","    return x.value"]},{"cell_type":"code","source":["def one_sample_sgd_fastlog(\n","    A: np.ndarray,      # <-- Mới (Ma trận A)\n","    b: np.ndarray,      # <-- Mới (Ràng buộc b)\n","    q0: np.ndarray,     # <-- Mới (ma trận 2D)\n","    valuations: np.ndarray,\n","    budgets: np.ndarray,\n","    p0: np.ndarray,\n","    lr_p=0.05, lr_q=0.05,\n","    num_iters=1000, seed=0,\n","    log_freq=50, time_limit=120.0,\n","    utility_type=\"Linear\"\n","):\n","    \"\"\"\n","    Phiên bản SGD cho mô hình Ma trận A (vector q_i).\n","    \"\"\"\n","    rng = np.random.default_rng(seed)\n","    n, m = valuations.shape\n","    T = A.shape[0] # n_slots (số hàng của A)\n","\n","    # --- Khởi tạo MỚI ---\n","    p = p0.astype(float).copy()\n","    q = q0.astype(float).copy() # q giờ là ma trận (n, T)\n","\n","    X = np.zeros((n, m))\n","    util = np.zeros(n)\n","\n","    # Khởi tạo X (dùng q[j] là vector)\n","    for j in range(n):\n","        X[j] = buyer_best_response_cvx(valuations[j], p, A, q[j], budgets[j], utility_type)\n","        if utility_type == \"Linear\":\n","            util[j] = valuations[j] @ X[j]\n","        elif utility_type == \"Cobb-Douglas\":\n","            util[j] = float(calculate_cd_utility(valuations[j], X[j]))\n","        elif utility_type == \"Leontief\":\n","            util[j] = float(calculate_leo_utility(valuations[j], X[j]))\n","\n","    D = X.sum(axis=0) # Tổng cầu (Demand)\n","\n","    # g_q_matrix thay thế cho 'slack' cũ\n","    # Đây là gradient đầy đủ của q, shape (n, T)\n","    # b = b.reshape((1, T))      # (1,4)\n","    # b = np.tile(b, (n, 1))     # (10,4)\n","    g_q_matrix = b - (X @ A.T)\n","\n","    obj_hist, X_hist, grad_hist, time_hist, X_norm_hist = [], [], [], [], []\n","    real_allocation_hist = []\n","    gp_norm_hist = []\n","    gq_norm_hist = []\n","\n","    t0 = time.perf_counter()\n","\n","    # --- Vòng lặp SGD ---\n","    for t in range(1, num_iters + 1):\n","        elapsed = time.perf_counter() - t0\n","        if elapsed >= time_limit:\n","            print(f\"⏱️ SGD-fastlog reached {elapsed:.2f}s → stopping.\")\n","            break\n","\n","        # 1. Chọn buyer ngẫu nhiên\n","        i = int(rng.integers(n))\n","\n","        # 2. Cập nhật D và X[i]\n","        D -= X[i]\n","        # Gọi hàm best_response MỚI (với q[i] là vector)\n","        x_i_new = buyer_best_response_cvx(valuations[i], p, A, q[i], budgets[i], utility_type)\n","\n","        # Kiểm tra nếu solver thất bại\n","        if x_i_new is None:\n","            print(f\"Lỗi Solver ở SGD iter {t} cho buyer {i}, bỏ qua bước này.\")\n","            D += X[i] # Thêm lại giá trị cũ\n","            continue # Bỏ qua vòng lặp này\n","\n","        X[i] = x_i_new\n","        if utility_type == \"Linear\":\n","            util[i] = valuations[i] @ X[i]\n","        elif utility_type == \"Cobb-Douglas\":\n","            util[i] = float(calculate_cd_utility(valuations[i], X[i]))\n","        elif utility_type == \"Leontief\":\n","            util[j] = float(calculate_leo_utility(valuations[i], X[i]))\n","\n","        D += x_i_new\n","\n","        # 3. Tính gradient (stochastic)\n","        # g_p vẫn là ước lượng không chệch\n","        g_p = np.ones(m) - n * x_i_new\n","\n","        # g_q_i MỚI: gradient cho q_i (vector)\n","        # g_q_i = b_i - A @ x_i\n","        g_q_i = b[i] - (A @ x_i_new)\n","\n","        # 4. Cập nhật p và q[i]\n","        alpha = lr_p / np.sqrt(t)\n","        beta = lr_q / np.sqrt(t)\n","\n","        p = np.maximum(p - alpha * g_p, 0.0)\n","        # Cập nhật q[i] MỚI (phép toán vector)\n","        q[i] = np.maximum(q[i] - beta * g_q_i, 0.0)\n","\n","        # 5. Cập nhật g_q_matrix (để log)\n","        # Chỉ cập nhật hàng 'i' đã thay đổi\n","        g_q_matrix[i] = g_q_i\n","\n","        # 6. Log định kỳ\n","        if t % log_freq == 0 or t == 1:\n","            # g_p_full (dùng D đã cập nhật)\n","            g_p_full = np.ones(m) - D\n","            # g_q_full chính là g_q_matrix\n","            grad_norm = np.linalg.norm(np.concatenate([g_p_full, g_q_matrix.ravel()]))\n","\n","            # Tính obj MỚI (dùng b thay vì energy)\n","            obj = p.sum() + (q * b).sum() + (budgets * np.log(util + 1e-12)).sum()\n","\n","            obj_hist.append(obj)\n","            grad_hist.append(grad_norm)\n","            X_hist.append(np.concatenate([p, q.ravel()]))\n","            time_hist.append(elapsed)\n","            real_allocation_hist.append(X.copy())\n","\n","            gp_norm_hist.append(np.linalg.norm(g_p_full))\n","            gq_norm_hist.append(np.linalg.norm(g_q_matrix))\n","\n","            X_norm_hist.append(np.linalg.norm(np.concatenate([p, q.ravel()])))\n","\n","            print(f\"[SGD-fastlog] iter={t:7d}  time={elapsed:6.2f}s  \"\n","                  f\"obj={obj:10.4f}  ‖g‖={grad_norm:.2e}\")\n","\n","    return obj_hist, X_hist, grad_hist, time_hist, X_norm_hist, real_allocation_hist, gp_norm_hist, gq_norm_hist"],"metadata":{"id":"Vnz4ehXDP8ky"},"execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"id":"wMf0fD9N6eh4"},"outputs":[],"source":["# --- CES/LINEAR(m=1) UTILITY (copied for completeness, unchanged as it handles n,k arrays) ---\n","def calculate_ces_utility(allocation_vec, valuations_vec, m=1):\n","    product = valuations_vec * allocation_vec\n","    if m == 'inf':\n","        return np.max(product, axis=1)\n","    else:\n","        sum_pow = np.sum(np.power(product, m), axis=1)\n","        return np.power(sum_pow, 1/m)\n","\n","# --- COBB-DOUGLAS UTILITY (Corrected) ---\n","def calculate_cd_utility(valuations_vec, allocation_vec):\n","  # eps = 1e-12\n","\n","  # # Ensure inputs are 2D for consistent axis operations\n","  # if valuations_vec.ndim == 1:\n","  #     valuations_vec = valuations_vec.reshape(1, -1)\n","  # if allocation_vec.ndim == 1:\n","  #     allocation_vec = allocation_vec.reshape(1, -1)\n","\n","  # # Normalize valuation weights for each user to sum to 1\n","  # sum_v = np.sum(valuations_vec, axis=1, keepdims=True)\n","  # norm_val = valuations_vec / (sum_v + eps)\n","\n","  # # Calculate utility term x_ij^(alpha_ij)\n","  # utility_term = np.power(allocation_vec + eps, norm_val)\n","\n","  # # Product along the items axis for each user\n","  # result = np.prod(utility_term, axis=1)\n","\n","  # return result\n","  eps = 1e-12\n","\n","  # Normalize shapes to 2D\n","  v = np.atleast_2d(valuations_vec)\n","  x = np.atleast_2d(allocation_vec)\n","\n","  # Normalize valuation weights (each user sums to 1)\n","  weights = v / (np.sum(v, axis=1, keepdims=True) + eps)\n","\n","  # Safe log CD utility:\n","  # U = prod(x_ij ^ w_ij) = exp(sum(w_ij * log(x_ij)))\n","  log_u = np.sum(weights * np.log(x + eps), axis=1)\n","\n","  # Convert log form back to utility\n","  u = np.exp(log_u)\n","\n","  # Return scalar if input was 1D, else return vector\n","  return float(u[0]) if valuations_vec.ndim == 1 else u\n","\n","# --- LEONTIEF UTILITY (Corrected) ---\n","def calculate_leo_utility(valuations_vec, allocation_vec):\n","  eps = 1e-12\n","\n","  # # Ensure inputs are 2D for consistent axis operations\n","  # if valuations_vec.ndim == 1:\n","  #     valuations_vec = valuations_vec.reshape(1, -1)\n","  # if allocation_vec.ndim == 1:\n","  #     allocation_vec = allocation_vec.reshape(1, -1)\n","\n","  # # Calculate x_ij / v_ij for each item and user\n","  # ratio_term = allocation_vec / (valuations_vec + eps)\n","\n","  # # Take the minimum ratio for each user\n","  # result = np.min(ratio_term, axis=1)\n","  # return result\n","  eps = 1e-12\n","\n","  # Normalize shapes to 2D\n","  v = np.atleast_2d(valuations_vec)\n","  x = np.atleast_2d(allocation_vec)\n","\n","  # Compute ratio x_ij / v_ij\n","  ratio = x / (v + eps)\n","\n","  # Leontief: min_j (x_ij / v_ij)\n","  u = np.min(ratio, axis=1)\n","\n","  # Return scalar if input was 1D, else return vector\n","  return float(u[0]) if valuations_vec.ndim == 1 else u"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"KUDbhqjFG3Cr"},"outputs":[],"source":["def robustness_graph(linear_alloc_hist, cd_alloc_hist, leo_alloc_hist, solver_alloc_final):\n","    linear_errors = []\n","    cd_errors = []\n","    leo_errors = []\n","\n","    # All allocation histories should have the same length as they come from the same number of iterations.\n","    # Assuming all histories are non-empty and of comparable length for initial plotting\n","    # Use the length of the shortest history to prevent index errors, though ideally they should be consistent\n","    length = min(len(linear_alloc_hist), len(cd_alloc_hist), len(leo_alloc_hist))\n","\n","    for i in range(length):\n","      # Calculate the norm of the difference between the current allocation and the final solver allocation\n","      linear_error = np.linalg.norm(linear_alloc_hist[i] - solver_alloc_final)\n","      cd_error = np.linalg.norm(cd_alloc_hist[i] - solver_alloc_final)\n","      leo_error = np.linalg.norm(leo_alloc_hist[i] - solver_alloc_final)\n","\n","      # Apply log scale, adding a small epsilon to avoid log(0) if error is exactly zero\n","      linear_errors.append(np.log(linear_error + 1e-12))\n","      cd_errors.append(np.log(cd_error + 1e-12))\n","      leo_errors.append(np.log(leo_error + 1e-12))\n","\n","    # --- Utility Function Robustness ---\n","    plt.figure(figsize=(8, 6))\n","    plt.plot(np.arange(0, length), linear_errors, color=\"blue\", label=\"Linear\")\n","    plt.plot(np.arange(0, l