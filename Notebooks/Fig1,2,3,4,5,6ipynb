datasets in EV charging with 10, 50, 300 users)"],"metadata":{"id":"L3XZvHQtSDgo"}},{"cell_type":"markdown","source":["**Goal:** Show that the stochastic approach (SPDS) minimizes error much faster in terms of wall-clock time compared to the deterministic approach (DPDS) and centralized solver. Also demonstrate that while the Centralized Solver eventually finds the perfect solution, the Stochastic (SPDS) method provides a \"good enough\" (e.g., 99% accurate) solution much earlier, making it better for real-time applications."],"metadata":{"id":"b2QYliasSrgt"}},{"cell_type":"markdown","source":["![image.png](data:image/png;base64,)"],"metadata":{"id":"c2N07dalStZi"}},{"cell_type":"markdown","source":["## Setup Function"],"metadata":{"id":"dMiRhAWBS4vp"}},{"cell_type":"code","source":["import pickle\n","import numpy as np\n","import matplotlib.pyplot as plt"],"metadata":{"id":"y3kdLy2_Ymri"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# print(solver_optimal_alloc)\n","# print(solver_time_tracker)"],"metadata":{"id":"jfSeRBpYTGjf"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["def efficiency_graph(\n","        spds_iter_alloc, dpds_iter_alloc,\n","        solver_optimal_alloc, spds_iter_time,\n","        dpds_iter_time, solver_time_tracker,\n","        instance_key):\n","    \"\"\"\n","    Draw time-based convergence efficiency graph.\n","\n","    Parameters:\n","    ----------\n","    spds_iter_alloc : list of np.array\n","        Allocation at each SPDS iteration (shape: n_buyers × n_goods)\n","\n","    dpds_iter_alloc : list of np.array\n","        Allocation at each DPDS iteration\n","\n","    spds_iter_time : list of float\n","        Cumulative SPDS wall-clock time at each iteration\n","\n","    dpds_iter_time : list of float\n","        Cumulative DPDS wall-clock time at each iteration (per-user parallel → will divide)\n","\n","    solver_time_tracker : dict\n","        Example: { '50u_60i' : 0.2412 }\n","\n","    solver_optimal_alloc : dict\n","        Example: { '50u_60i' : X_star }\n","\n","    instance_key : str\n","        Example: \"50u_60i\"\n","    \"\"\"\n","\n","    # ---------- Step 1 — Get number of users ----------\n","    n_users = int(instance_key.split(\"u\")[0])\n","    X_star = solver_optimal_alloc[instance_key]     # Optimal allocation (vector)\n","    solver_time = solver_time_tracker[instance_key]\n","\n","    # ---------- Step 2 — Convert all allocations to errors ----------\n","    def compute_log_errors(alloc_list):\n","        errors = []\n","        for A in alloc_list:\n","            diff = np.linalg.norm(A - X_star)\n","            errors.append(np.log(diff + 1e-12))\n","        return np.array(errors)\n","\n","    spds_errors = compute_log_errors(spds_iter_alloc)\n","    dpds_errors = compute_log_errors(dpds_iter_alloc)\n","    solver_errors = compute_log_errors(solver_optimal_alloc)\n","\n","    # ---------- Step 3 — Adjust time for SPDS ----------\n","    spds_time = np.array(spds_iter_time) / n_users\n","    dpds_time = np.array(dpds_iter_time)\n","    solver_time = np.array(solver_time)  # flat or multiple iterations\n","\n","\n","    # ---------- Step 4 — Draw everything ----------\n","    plt.figure(figsize=(10, 6))\n","\n","    # SPDS line\n","    plt.plot(spds_time, spds_errors, 'r--', linewidth=2, label=\"SPDS (Stochastic)\")\n","\n","    # DPDS line\n","    plt.plot(dpds_time, dpds_errors, 'b-', linewidth=2, label=\"DPDS (Deterministic)\")\n","\n","    # Centralized solver line (dotted)\n","    plt.plot(solver_time, solver_errors, 'k:', linewidth=2.5, label=\"Centralized Solver\")\n","\n","    # ---------- Formatting ----------\n","    plt.xlabel(\"Wall-Clock Time (s)\", fontsize=14)\n","    plt.ylabel(\"Relative Error (Log Scale)\", fontsize=14)\n","    plt.title(\"Convergence Efficiency (Time-Based)\", fontsize=15)\n","\n","    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.6)\n","    plt.legend(fontsize=12)\n","    plt.tight_layout()\n","    plt.show()"],"metadata":{"id":"qsE-niCxZF5g"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","def efficiency_graph(\n","        spds_iter_alloc, dpds_iter_alloc, solver_optimal_alloc,\n","        spds_iter_time, dpds_iter_time,\n","        solver_time_tracker,instance_key):\n","\n","    # ----- Extract required data -----\n","    solver_time = solver_time_tracker[instance_key]\n","    X_star = solver_optimal_alloc[instance_key]\n","    n_users = int(instance_key.split(\"u\")[0])\n","\n","    # number of users: parse \"10u_24i\" → 10\n","    n_users = int(instance_key.split(\"u\")[0])\n","\n","    # ----- Helper: compute relative error curve -----\n","    def compute_error_curve(alloc_list):\n","        return np.array([\n","            np.log(np.linalg.norm(A - X_star) + 1e-12)\n","            for A in alloc_list\n","        ])\n","\n","    # Compute SPDS + DPDS error curves\n","    spds_error = compute_error_curve(spds_iter_alloc)\n","    dpds_error = compute_error_curve(dpds_iter_alloc)\n","\n","    # Correct SPDS time (parallel users)\n","    spds_time = np.array(spds_iter_time)\n","    dpds_time = np.array(dpds_iter_time)\n","\n","    # ----- Central Solver line construction -----\n","    # constant error = log(norm(solver_alloc))\n","    solver_error_const = np.log(np.linalg.norm(X_star) + 1e-12)\n","\n","    solver_time_array = np.array([0, solver_time])\n","    solver_error_array = np.array([solver_error_const, 0])\n","\n","    # ----- Plotting -----\n","    print(spds_error)\n","    print(len(spds_error))\n","    print(len(spds_time))\n","    print(solver_time_array)\n","    print(solver_error_array)\n","    plt.figure(figsize=(12, 7))\n","\n","    plt.plot(spds_time, spds_error,\n","                 'r--', linewidth=2, label=\"SPDS (Stochastic)\")\n","    plt.plot(dpds_time, dpds_error,\n","                 'b-', linewidth=2, label=\"DPDS (Deterministic)\")\n","    plt.plot(solver_time_array, solver_error_array,\n","                 'k:', linewidth=2, label=\"Centralized Solver\")\n","\n","    plt.xlabel(\"Wall-Clock Time (s)\", fontsize=14)\n","    plt.ylabel(\"Relative Error (Log Scale)\", fontsize=14)\n","    plt.title(\"Convergence Efficiency (Time-Based)\", fontsize=16)\n","    plt.grid(True, which=\"both\", linestyle=\"--\", linewidth=0.6)\n","    plt.legend(fontsize=12)\n","    plt.tight_layout()\n","    plt.show()\n"],"metadata":{"id":"ZWVZFEvTphwr"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## 50 users 60 items"],"metadata":{"id":"ZJgmf1kfSlDx"}},{"cell_type":"code","source":["spds_iter_alloc = []\n","dpds_iter_alloc = []\n","spds_iter_time = []\n","dpds_iter_time = []"],"metadata":{"id":"P5nwTu87ZIdz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["print(solver_time_tracker[\"50u_60i\"])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Z4g-WgTYoMKA","executionInfo":{"status":"ok","timestamp":1764993339008,"user_tz":-420,"elapsed":24,"user":{"displayName":"Hong Chu","userId":"14501893030136914855"}},"outputId":"77c73a6c-e0ac-40fc-e7a7-10acfbab62ab"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["0.19212756199704017\n"]}]},{"cell_type":"code","source":["results[\"sgd_run\"].keys()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"T5PNZVjFsSOz","executionInfo":{"status":"ok","timestamp":1764993339053,"user_tz":-420,"elapsed":10,"user":{"displayName":"Hong Chu","userId":"14501893030136914855"}},"outputId":"e2577281-01a0-461d-f4f2-30676453ced7"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["dict_keys(['obj', 'X_final', 'grad_final', 'time_log', 'X_norm_log', 'alloc_final', 'gp_hist', 'gq_hist', 'total_time'])"]},"metadata":{},"execution_count":575}]},{"cell_type":"code","source":["load_path = \"/content/drive/MyDrive/EV_charging_project/experiment_